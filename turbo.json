{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "STELLAR_NETWORK",
    "RPC_URL",
    "NETWORK_PASSPHRASE",
    "HORIZON_URL",
    "FRIENDBOT_URL",
    "USDC_SAC_ID",
    "REFLECTOR_FEED_ID",
    "ADMIN_ADDRESS",
    "LAUNCHTUBE_URL",
    "LAUNCHTUBE_JWT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}

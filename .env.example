# ---------------------------------------------------------------------------
# Kaido environment template — copy to .env and fill per network.
# NOTHING in here is hardcoded into contract logic; the contracts read these
# values at deploy time and store them in their own config. See build.md §0a.
# ---------------------------------------------------------------------------

# Which network this checkout targets: local | testnet | futurenet | mainnet
# Default is testnet — Kaido develops/deploys against Stellar Testnet (no local
# Docker node). Use `local` only if you specifically want the offline quickstart.
STELLAR_NETWORK=testnet

# RPC + network identity. Source of truth: https://developers.stellar.org/docs/networks
# testnet   -> https://soroban-testnet.stellar.org | "Test SDF Network ; September 2015"
# local     -> http://localhost:8000/rpc           | "Standalone Network ; February 2017"
# mainnet   -> a third-party RPC provider           | "Public Global Stellar Network ; September 2015"
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# Settlement asset: the USDC Stellar Asset Contract id for this network.
# Resolve per network at deploy time — never commit a mainnet id into source.
USDC_SAC_ID=

# Reflector SEP-40 price feed contract id for this network (testnet != mainnet).
# Look it up on the Reflector site's /oracles tab at deploy time.
REFLECTOR_FEED_ID=

# Protocol admin (multisig recommended on mainnet).
ADMIN_ADDRESS=

# Launchtube — submits passkey-signed transactions. Per-network endpoint + JWT.
LAUNCHTUBE_URL=
LAUNCHTUBE_JWT=

# Deployer account used by scripts. Either a raw secret key here, OR set
# DEPLOYER_KEY_NAME to a key managed by the Stellar CLI (`stellar keys ...`).
# Testnet only — never put a mainnet key here. If both are empty, the testnet
# deploy script generates a fresh key and funds it via Friendbot.
DEPLOYER_SECRET_KEY=
DEPLOYER_KEY_NAME=kaido-testnet-deployer

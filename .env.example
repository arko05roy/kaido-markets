# ---------------------------------------------------------------------------
# Kaido environment template — copy to .env and fill per network.
# NOTHING in here is hardcoded into contract logic; the contracts read these
# values at deploy time and store them in their own config. See build.md §0a.
# ---------------------------------------------------------------------------

# Which network this checkout targets: local | testnet | futurenet | mainnet
STELLAR_NETWORK=testnet

RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# --- Hackathon demo (recommended for testnet) --------------------------------
# Mints KAIDO token, skips BlendTap, LP-seeds markets. USDC_SAC_ID not required.
KAIDO_DEMO=1
KAIDO_ASSET_CODE=KAIDO
KAIDO_MINT_AMOUNT=1000000000000
KAIDO_FAUCET_AMOUNT_7DP=500000000000000
DEMO_B_WAD=100000000000000000000000

# --- Production / BlendTap path (set KAIDO_DEMO=0) -------------------------
# USDC_SAC_ID=
# BLEND_POOL_ID=
# BLEND_USDC_SAC_ID=

# Reflector SEP-40 price feed contract id for this network.
REFLECTOR_FEED_ID=
REFLECTOR_ASSET_SYMBOL=BTC

ATTESTED_POSTER_SECRET_KEY=
ATTESTED_POSTER_G=
ATTESTED_POSTER_PUBKEY_HEX=
ATTESTED_CHALLENGE_WINDOW_SECS=3600
OPTIMISTIC_DISPUTE_WINDOW_SECS=600
OPTIMISTIC_MIN_BOND=1000000

ADMIN_ADDRESS=

DEPLOYER_SECRET_KEY=
DEPLOYER_KEY_NAME=kaido-testnet-deployer

# Neon Postgres — persistent market question copy (set on Vercel; optional locally).
# Without this, metadata is stored in web/data/market-questions.json (dev only).
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Demo faucet: SAC transfer signer (treasury holds LP seed balance)
KAIDO_TREASURY_SECRET_KEY=
KAIDO_TREASURY_KEY_NAME=kaido-testnet-treasury
